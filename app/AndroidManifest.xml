<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.pureguard"
    android:versionCode="20"
    android:versionName="1.19">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Wireless-debugging activation: the pairing code is typed into a notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Activate another phone" by cable: this phone is the USB host. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Granted by setup (pm grant): lets the app re-enable its own pieces if someone turns them off. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- From the Shizuku provider library's manifest (not merged: this build has no Gradle). -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />

        <activity
            android:name=".Main"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Boot / update / shutdown hook (a device-admin receiver from older builds; never activated now). -->
        <receiver
            android:name=".Admin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
            </intent-filter>
        </receiver>

        <!-- DNS-only VPN: every app's DNS goes through the blocklist and CleanBrowsing. -->
        <service
            android:name=".Vpn"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Backup layer: browser address bars, and the screens that would switch protection off. -->
        <service
            android:name=".Watch"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/watch" />
        </service>

        <!-- Gets the pairing code typed into the activation notification. -->
        <receiver android:name=".Activate" android:exported="false" />

        <!-- Shizuku hands this app its binder through this provider (no-PC setup). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="local.pureguard.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name=".ApkProvider"
            android:authorities="local.pureguard.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
